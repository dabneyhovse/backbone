# --- Server ---
# Port the Express server listens on
PORT=8080

# Base URL where this app is reachable locally
# If you change PORT above, update this too
BASE_URL=http://localhost:8080

# --- PostgreSQL ---
# The app connects to a database named "DabneyBackbone" on localhost:5432
# Create a local DB and user with access, then set the creds below.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme

# --- OpenID Connect (Keycloak/Auth0-compatible) ---
# Issuer URL of your IdP (Keycloak realm, etc.)
# Example for Keycloak: https://keycloak.example.com/realms/dabney
ISSUER_BASE_URL=

# Client ID registered in the IdP for this app
CLIENT_ID=

# Long random secret used by express-openid-connect for session encryption
# Example: run `openssl rand -base64 32`
SECRET=

# If your IdP requires mTLS, the module `module-keycloak/mTLSAgent`
# will look for certs/keys using its own defaults. Configure that module
# as required by your environment.

# Optional: override the default Node environment
# NODE_ENV=development
